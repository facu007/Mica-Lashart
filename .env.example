# ==============================================================================
# MICA LASH ART — CONFIGURACIÓN DE ENTORNO SUPABASE
# ==============================================================================
# Copiá este archivo como .env y completá con los valores de tu proyecto en Supabase:
# 1. Creá tu proyecto en https://supabase.com
# 2. Andá a Project Settings > API
# 3. Copiá "Project URL" y "Project API keys (anon / public)"
# ==============================================================================

PORT=3456

# URL del proyecto en Supabase (ejemplo: https://xyzcompany.supabase.co)
SUPABASE_URL=

# Clave pública anónima (anon / public key)
SUPABASE_ANON_KEY=

# Clave secreta de servicio (service_role key - opcional, solo para backend seguro)
SUPABASE_SERVICE_ROLE_KEY=

# Datos del Estudio
STUDIO_WHATSAPP=5492914491141
ADMIN_EMAIL=micaela@lashart.com
